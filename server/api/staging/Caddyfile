# /etc/caddy/Caddyfile on the VPS: the staging API host only. Caddy gets the certificate itself.
#
# Keep the API hostname's DNS record "DNS only" (grey cloud) in Cloudflare. Then Caddy sees the visitor's address and
# appends it to X-Forwarded-For, which the server needs (it reads the LAST entry and answers 403 client_ip_required
# without one). If you later turn the orange cloud on, Caddy would see only Cloudflare's addresses and every user would
# share one rate-limit bucket; that needs Cloudflare's ranges as trusted proxies, which is a separate change.
#
# The server listens on loopback only (VERSHION_LISTEN=127.0.0.1:8787), so only Caddy can reach it.

staging-api.lefthanddev.com {
	encode gzip

	reverse_proxy 127.0.0.1:8787

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Strict-Transport-Security "max-age=31536000"
	}

	# A little above the largest body the server accepts (the AI relay's 13 MB; a publish is about 5 MB). The server
	# enforces its own, tighter caps per route.
	request_body {
		max_size 16MB
	}
}
