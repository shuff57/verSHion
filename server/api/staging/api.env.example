# /etc/vershion-staging/api.env on the VPS (mode 600, owner root). Fill in by hand on the server.
# Never commit the filled-in file, never paste its values into chat, never use live Stripe keys here.
# Use FRESH secrets for staging: reusing production's AUTH_SECRET or POOL_HASH_KEY would tie the two together.
# POOL_HASH_KEY can never be rotated once staging holds data you want to keep; keep an offline copy.

# --- required (32+ characters each; generate on the server: head -c48 /dev/urandom | base64 | tr -d '/+=\n') ---
AUTH_SECRET=
POOL_HASH_KEY=

# --- where things live ---
VERSHION_DB=/var/lib/vershion-staging/pool.db
VERSHION_BLOBS=/var/lib/vershion-staging/blobs
VERSHION_MIGRATIONS=/opt/vershion-staging/migrations
VERSHION_LISTEN=127.0.0.1:8787

# --- the app's web build on Cloudflare Pages: the EXACT page origin (https, no trailing slash, no wildcard) ---
# The page and the API must share one registrable domain (staging-app.lefthanddev.com and staging-api.lefthanddev.com do):
# the refresh cookie is SameSite=Strict; Secure.
ALLOWED_ORIGINS=https://staging-app.lefthanddev.com
APP_URL=https://staging-app.lefthanddev.com

# --- mail: real SMTP. MAIL_MODE=log is refused unless APP_URL is local, because it prints live tokens. ---
SMTP_HOSTNAME=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURE=
# The planned Stalwart mailbox (HANDOFF.md). Its domain has DMARC p=reject: check SPF and DKIM for lefthanddev.com
# before the first test, or sign-up mails may land in spam.
MAIL_FROM=vershion@lefthanddev.com
SMTP_FROM_NAME=verSHion staging
ADMIN_EMAIL=
# ESCALATION_EMAIL=

# --- AI harness ---
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=
# AI_WEEKLY_CREDITS=
# AI_DAILY_USD=1

# --- paid tier: Stripe TEST mode only (sk_test_..., pk_test_...). The webhook secret is the one of the staging endpoint
# https://staging-api.lefthanddev.com/billing/webhook, created in the Stripe dashboard in test mode. ---
BILLING_ENABLED=1
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
