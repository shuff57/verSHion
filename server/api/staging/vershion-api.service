# /etc/systemd/system/vershion-api-staging.service
# Staging copy of the Rust server. Secrets live only in /etc/vershion-staging/api.env (mode 600), never here.
[Unit]
Description=verSHion API (staging)
After=network-online.target
Wants=network-online.target

[Service]
User=vershion
Group=vershion
EnvironmentFile=/etc/vershion-staging/api.env
ExecStart=/opt/vershion-staging/vershion-api
Restart=on-failure
RestartSec=3

# The only places it may write: its database and blob directory.
StateDirectory=vershion-staging
ReadWritePaths=/var/lib/vershion-staging
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
# Sending mail and calling OpenRouter and Stripe need outbound network; nothing else is needed.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
