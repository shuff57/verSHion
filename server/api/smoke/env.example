# Environment for a LOCAL first run. Copy to env.local (git-ignored by name below), fill in, then:
#   set -a; . server/api/smoke/env.local; set +a
# Never commit env.local, never put a live Stripe key here. Test keys only (sk_test_..., pk_test_..., whsec_...).

# --- required for sign-in and the pool (32+ characters each; generate with: head -c48 /dev/urandom | base64 | tr -d '/+=\n') ---
AUTH_SECRET=
POOL_HASH_KEY=

# --- where things live (relative paths resolve from where you start the server) ---
VERSHION_DB=./data/pool.db
VERSHION_BLOBS=./data/blobs
VERSHION_MIGRATIONS=./server/worker/migrations
VERSHION_LISTEN=127.0.0.1:8787

# --- browsers: the EXACT origin the app's web build is served from (credentials are sent, so no wildcard, no trailing slash). ---
# `trunk serve` (Trunk.toml) listens on http://localhost:8781. A different port or host is a different origin.
# In the app's Account screen type the API address as seen through Caddy: http://localhost:8080 (see Caddyfile).
ALLOWED_ORIGINS=http://localhost:8781

# --- mail: log mode prints each message, with its live token, to the server log. It refuses to run unless APP_URL is local. ---
# APP_URL is where mailed links point (/account/verify#token=...): the app's web build, the same origin as above.
MAIL_MODE=log
APP_URL=http://localhost:8781
ADMIN_EMAIL=admin@example.org

# --- AI harness (leave OPENROUTER_API_KEY empty to see the "not configured" answers; add your own key to test live) ---
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=
# AI_WEEKLY_CREDITS=20
# AI_CHAT_PER_HOUR=
# AI_DAILY_USD=

# --- paid tier (leave BILLING_ENABLED=0 to skip; test keys only) ---
BILLING_ENABLED=0
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# From `stripe listen --forward-to http://127.0.0.1:8787/billing/webhook`, which prints a whsec_ value:
STRIPE_WEBHOOK_SECRET=
